#!/bin/zsh
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if [[ -n "${CHAT_BRIDGE_MAIN:-}" ]]; then
  MAIN="$CHAT_BRIDGE_MAIN"
elif [[ -f "$REPO_ROOT/src/main.js" ]]; then
  MAIN="$REPO_ROOT/src/main.js"
else
  MAIN="$HOME/.local/share/chatgpt-chat-bridge/main.js"
fi

EGO_BROWSER="${EGO_BROWSER_BIN:-$HOME/.local/bin/ego-browser}"
if [[ ! -x "$EGO_BROWSER" ]]; then
  EGO_BROWSER="$(command -v ego-browser || true)"
fi
[[ -x "$EGO_BROWSER" ]] || { echo "chat-bridge: ego-browser not found" >&2; exit 127; }
[[ -f "$MAIN" ]] || { echo "chat-bridge: runtime not found: $MAIN" >&2; exit 127; }

ARGS_JSON="$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1:], ensure_ascii=False))' "$@")"
{ printf 'globalThis.__CHAT_BRIDGE_ARGS__ = %s;\n' "$ARGS_JSON"; cat "$MAIN"; } | exec "$EGO_BROWSER" nodejs
