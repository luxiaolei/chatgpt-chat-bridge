#!/bin/zsh
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if [[ -n "${CHAT_BRIDGE_MAIN:-}" ]]; then
  MAIN="$CHAT_BRIDGE_MAIN"
elif [[ -f "$REPO_ROOT/src/main.js" ]]; then
  MAIN="$REPO_ROOT/src/main.js"
else
  MAIN="$HOME/.local/share/chatgpt-chat-bridge/main.js"
fi

STATE_DIR="${CHAT_BRIDGE_STATE_DIR:-$HOME/.local/state/chat-bridge}"
CONFIG_DIR="${CHAT_BRIDGE_CONFIG_DIR:-$HOME/.config/chat-bridge}"
PREFLIGHT="${MAIN:h}/web-preflight.py"
CAPACITY_PREFLIGHT="${MAIN:h}/capacity-preflight.py"
UI_MIN_INTERVAL_SEC="${CHAT_BRIDGE_UI_MIN_INTERVAL_SEC:-10}"
UI_HEAVY_INTERVAL_SEC="${CHAT_BRIDGE_UI_HEAVY_INTERVAL_SEC:-30}"
MAX_INLINE_WAIT_SEC="${CHAT_BRIDGE_MAX_INLINE_WAIT_SEC:-5}"
LOCK_WAIT_SEC="${CHAT_BRIDGE_LOCK_WAIT_SEC:-5}"
EGO_CLIENT_TIMEOUT_SEC="${CHAT_BRIDGE_EGO_CLIENT_TIMEOUT_SEC:-180}"

python3 - "$UI_MIN_INTERVAL_SEC" "$UI_HEAVY_INTERVAL_SEC" "$MAX_INLINE_WAIT_SEC" "$LOCK_WAIT_SEC" "$EGO_CLIENT_TIMEOUT_SEC" <<'PY' >/dev/null
import sys
normal,heavy,max_wait,lock_wait,ego_timeout=map(float,sys.argv[1:])
if normal < 10:
    raise SystemExit("CHAT_BRIDGE_UI_MIN_INTERVAL_SEC must be >= 10")
if heavy < 30:
    raise SystemExit("CHAT_BRIDGE_UI_HEAVY_INTERVAL_SEC must be >= 30")
if max_wait < 0 or max_wait > 5:
    raise SystemExit("CHAT_BRIDGE_MAX_INLINE_WAIT_SEC must be between 0 and 5")
if lock_wait < 0 or lock_wait > 5:
    raise SystemExit("CHAT_BRIDGE_LOCK_WAIT_SEC must be between 0 and 5")
if ego_timeout < 30 or ego_timeout > 600:
    raise SystemExit("CHAT_BRIDGE_EGO_CLIENT_TIMEOUT_SEC must be between 30 and 600")
PY

emit_tempfail() {
  python3 - "$@" <<'PY'
import json,math,sys
code,status,reason,retry_after,until=sys.argv[1:]
payload={"ok":False,"status":status,"reason":reason,"code":code,
         "retryAfterSec":max(1,math.ceil(float(retry_after)))}
if until: payload["until"]=until
print(json.dumps(payload,ensure_ascii=False))
PY
}

CMD="${1:-help}"
SUB="${2:-}"

if [[ "$CMD" == "ask" ]]; then
  ASK_WRAPPER="${MAIN:h}/ask-wrapper.py"
  [[ -f "$ASK_WRAPPER" ]] || { echo "chat-bridge: ask wrapper missing: $ASK_WRAPPER" >&2; exit 127; }
  exec python3 "$ASK_WRAPPER" "$0" "${@:2}"
fi

if [[ "$CMD" == "queue" ]]; then
  COORDINATOR="${MAIN:h}/coordinator.py"
  [[ -f "$COORDINATOR" ]] || { echo "chat-bridge: coordinator missing: $COORDINATOR" >&2; exit 127; }
  exec python3 "$COORDINATOR" "$SUB" "$CONFIG_DIR" "$STATE_DIR" "${@:3}"
fi
if [[ "$CMD" == "control" ]]; then
  COORDINATOR="${MAIN:h}/coordinator.py"
  [[ -f "$COORDINATOR" ]] || { echo "chat-bridge: coordinator missing: $COORDINATOR" >&2; exit 127; }
  exec python3 "$COORDINATOR" control "$CONFIG_DIR" "$STATE_DIR" "${@:2}"
fi

LOCAL_QUERY="${MAIN:h}/local-query.py"
if [[ -f "$LOCAL_QUERY" ]]; then
  if [[ "$CMD" == "topology" ]]; then
    exec python3 "$LOCAL_QUERY" topology "$CONFIG_DIR" "$STATE_DIR" "${@:2}"
  elif [[ "$CMD" == "runtime" ]]; then
    exec python3 "$LOCAL_QUERY" runtime "$CONFIG_DIR" "$STATE_DIR" "${@:2}"
  elif [[ "$CMD" == "list" ]]; then
    exec python3 "$LOCAL_QUERY" chat-list "$CONFIG_DIR" "$STATE_DIR" "${@:2}"
  elif [[ "$CMD" == "task" && "$SUB" == "list" ]]; then
    exec python3 "$LOCAL_QUERY" task-list "$CONFIG_DIR" "$STATE_DIR" "${@:3}"
  elif [[ "$CMD" == "event" && "$SUB" == "list" ]]; then
    exec python3 "$LOCAL_QUERY" event-list "$CONFIG_DIR" "$STATE_DIR" "${@:3}"
  fi
fi

if [[ "$CMD" == "capacity" ]]; then
  exec python3 "$CAPACITY_PREFLIGHT" capacity "$CONFIG_DIR" "$STATE_DIR" "${@:2}"
fi
if [[ "$CMD" == "account" && "$SUB" == "select" ]]; then
  exec python3 "$CAPACITY_PREFLIGHT" select "$CONFIG_DIR" "$STATE_DIR" "${@:3}"
fi
if [[ "$CMD" == "new" && " ${*} " == *" --auto-account "* && " ${*} " != *" --account "* ]]; then
  PROJECT_ARG="$(python3 -c 'import sys; a=sys.argv[1:]; print(a[a.index("--project")+1] if "--project" in a and a.index("--project")+1<len(a) else "")' "$@")"
  AFFINITY_ARG="$(python3 -c 'import sys; a=sys.argv[1:]; print(a[a.index("--affinity-key")+1] if "--affinity-key" in a and a.index("--affinity-key")+1<len(a) else "")' "$@")"
  [[ -n "$PROJECT_ARG" ]] || { echo "new --auto-account requires --project" >&2; exit 2; }
  if [[ -n "$AFFINITY_ARG" ]]; then
    SELECTED_JSON="$(python3 "$CAPACITY_PREFLIGHT" select "$CONFIG_DIR" "$STATE_DIR" --project "$PROJECT_ARG" --affinity-key "$AFFINITY_ARG")"
  else
    SELECTED_JSON="$(python3 "$CAPACITY_PREFLIGHT" select "$CONFIG_DIR" "$STATE_DIR" --project "$PROJECT_ARG")"
  fi
  SELECTED_ACCOUNT="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["selectedAccount"])' <<<"$SELECTED_JSON")"
  set -- "$@" --account "$SELECTED_ACCOUNT"
fi

ORIGIN_ROUTED=0
case "$CMD" in
  send|ask|new|read|status|sync|resend|model|effort|stop|retry|recover|archive|retire|delete|projects|discover|list|event|task|project)
    ORIGIN_ROUTED=1 ;;
  space)
    [[ "$SUB" == "show" || "$SUB" == "prune" || "$SUB" == "consolidate" ]] && ORIGIN_ROUTED=1 ;;
esac
if (( ORIGIN_ROUTED )) && [[ -n "${CHAT_BRIDGE_FROM_ACCOUNT_ID:-}" ]]; then
  ORIGIN_ACCOUNT="$(python3 "$PREFLIGHT" origin-account "$CONFIG_DIR" "$STATE_DIR" "$@")"
  if [[ " ${*} " != *" --account "* ]]; then
    set -- "$@" --account "$ORIGIN_ACCOUNT"
  fi
elif (( ORIGIN_ROUTED )) && [[ -n "${CHAT_BRIDGE_FROM_SPACE:-}" && " ${*} " != *" --account "* ]]; then
  ORIGIN_ACCOUNT="$(python3 "$PREFLIGHT" origin "$CONFIG_DIR" "$STATE_DIR" "$@")"
  set -- "$@" --account "$ORIGIN_ACCOUNT"
fi
if [[ -z "${CHAT_BRIDGE_FROM_SPACE:-}" && -z "${CHAT_BRIDGE_FROM_ACCOUNT_ID:-}" && " ${*} " != *" --account "* ]]; then
  case "$CMD" in
    send|ask|new|read|status|sync|resend|model|effort|stop|retry|recover|archive|retire|delete)
      python3 "$PREFLIGHT" unambiguous "$CONFIG_DIR" "$STATE_DIR" "$@"
      ;;
  esac
fi

if [[ "$CMD" == "cooldown" ]]; then
  case "$SUB" in
    ""|show|status)
      python3 "$PREFLIGHT" status "$CONFIG_DIR" "$STATE_DIR" "$@"
      exit 0
      ;;
    clear)
      if [[ " ${*} " != *" --confirm "* ]]; then
        echo '{"ok":false,"status":"CONFIRMATION_REQUIRED","reason":"COOLDOWN_CLEAR_REQUIRES_CONFIRM"}' >&2
        exit 2
      fi
      python3 "$PREFLIGHT" clear "$CONFIG_DIR" "$STATE_DIR" "$@"
      exit 0
      ;;
    *)
      echo "cooldown subcommand must be status, show, or clear --confirm" >&2
      exit 2
      ;;
  esac
fi

TOUCH_UI=0
HEAVY_UI=0
case "$CMD" in
  projects|sync|discover|read|status|send|ask|model|effort|stop|retry|recover|resend|new|archive|retire|delete|watch)
    TOUCH_UI=1
    ;;
  space)
    [[ "$SUB" == "prune" || "$SUB" == "scan" || "$SUB" == "restore" || "$SUB" == "gc" || "$SUB" == "consolidate" ]] && TOUCH_UI=1
    ;;
  project)
    [[ "$SUB" == "ensure" ]] && TOUCH_UI=1
    ;;
  account)
    [[ "$SUB" == "identify" ]] && TOUCH_UI=1
    ;;
esac
case "$CMD" in
  new|archive|retire|delete)
    HEAVY_UI=1
    ;;
  space)
    [[ ( "$SUB" == "gc" || "$SUB" == "consolidate" ) && "$*" == *"--confirm"* ]] && HEAVY_UI=1
    ;;
  project)
    [[ "$SUB" == "ensure" && "$*" == *"--create"* && "$*" == *"--confirm"* ]] && HEAVY_UI=1
    ;;
esac

# Watch all requested accounts locally; one cooling account must not mask another.
if [[ "$CMD" == "watch" ]]; then
  if (( ${@[(Ie)--loop]} )); then
    exec python3 "$PREFLIGHT" loop "$CONFIG_DIR" "$STATE_DIR" "$0" "$@"
  fi
  if (( ! ${@[(Ie)--account]} )); then
    exec python3 "$PREFLIGHT" watch-all "$CONFIG_DIR" "$STATE_DIR" "$0" "$@"
  fi
  HAS_ACTIVE="$(python3 "$PREFLIGHT" watch "$CONFIG_DIR" "$STATE_DIR" "$@")"
  if [[ "$HAS_ACTIVE" != "1" ]]; then
    exit 0
  fi
fi

if [[ "$CMD" == "send" || "$CMD" == "new" ]] && [[ " ${*} " != *" --background "* ]]; then
  COORDINATOR="${MAIN:h}/coordinator.py"
  PROJECT_ARG="$(python3 -c 'import sys; a=sys.argv[1:]; print(a[a.index("--project")+1] if "--project" in a and a.index("--project")+1<len(a) else "")' "$@")"
  python3 "$COORDINATOR" admission-check "$CONFIG_DIR" "$STATE_DIR" "$PROJECT_ARG" >/dev/null
fi

if (( TOUCH_UI )) && [[ "$CMD" != "watch" ]]; then
  mkdir -p "$STATE_DIR"
  COOLDOWN_STATE="$(python3 "$PREFLIGHT" gate "$CONFIG_DIR" "$STATE_DIR" "$@")"
  REMAINING="${COOLDOWN_STATE%%|*}"
  if python3 - "$REMAINING" <<'PY'
import sys
raise SystemExit(0 if float(sys.argv[1])>0.01 else 1)
PY
  then
    COOLDOWN_REST="${COOLDOWN_STATE#*|}"
    COOLDOWN_UNTIL="${COOLDOWN_REST%%|*}"
    emit_tempfail WEB_COOLDOWN_ACTIVE COOLDOWN CHATGPT_RATE_LIMIT "$REMAINING" "$COOLDOWN_UNTIL" >&2
    exit 75
  fi
fi

EGO_BROWSER="${EGO_BROWSER_BIN:-$HOME/.local/bin/ego-browser}"
if [[ ! -x "$EGO_BROWSER" ]]; then
  EGO_BROWSER="$(command -v ego-browser || true)"
fi
[[ -x "$EGO_BROWSER" ]] || { echo "chat-bridge: ego-browser not found" >&2; exit 127; }
[[ -f "$MAIN" ]] || { echo "chat-bridge: runtime not found: $MAIN" >&2; exit 127; }
CONTROL="${CHAT_BRIDGE_CONTROL:-${MAIN:h}/control-routing.js}"
PAGE_POOL="${CHAT_BRIDGE_PAGE_POOL:-${MAIN:h}/page-pool.js}"
LIVENESS="${CHAT_BRIDGE_LIVENESS_POLICY:-${MAIN:h}/liveness-policy.js}"
TASK_POLICY="${CHAT_BRIDGE_TASK_POLICY:-${MAIN:h}/task-policy.js}"
LIFECYCLE_POLICY="${CHAT_BRIDGE_LIFECYCLE_POLICY:-${MAIN:h}/lifecycle-policy.js}"
WEB_POLICY="${CHAT_BRIDGE_WEB_POLICY:-${MAIN:h}/web-policy.js}"
MODEL_POLICY="${MAIN:h}/model-policy.js"
SESSION_POLICY="${MAIN:h}/session-policy.js"
EVENT_JOURNAL="${MAIN:h}/event-journal.js"
TOPOLOGY="${MAIN:h}/topology.js"
SPACE_CATALOG="${MAIN:h}/space-catalog.js"
[[ -f "$SPACE_CATALOG" ]] || SPACE_CATALOG="${MAIN:h}/space-catalog.mjs"
for f in "$CONTROL" "$PAGE_POOL" "$LIVENESS" "$TASK_POLICY" "$LIFECYCLE_POLICY" "$WEB_POLICY" "$MODEL_POLICY" "$SESSION_POLICY" "$EVENT_JOURNAL" "$TOPOLOGY"; do
  [[ -f "$f" ]] || { echo "chat-bridge: runtime module not found: $f" >&2; exit 127; }
done
[[ -f "$SPACE_CATALOG" ]] || { echo "chat-bridge: space catalog module not found" >&2; exit 127; }
SPACE_CATALOG_JSON="$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$SPACE_CATALOG")"

# Serialize ChatGPT UI per stable account identity. Different logged-in accounts may progress independently.
PACE_SCOPE="$(python3 "$PREFLIGHT" scope "$CONFIG_DIR" "$STATE_DIR" "$@")"
[[ -n "$PACE_SCOPE" ]] || { echo "chat-bridge: unable to resolve pacing account scope" >&2; exit 2; }
LOCK_DIR="$STATE_DIR/ui-pacing-$PACE_SCOPE.lock"
STAMP_FILE="$STATE_DIR/ui-pacing-$PACE_SCOPE.last"
LEGACY_STAMP_FILE="$STATE_DIR/ui-pacing.last"
if [[ ! -f "$STAMP_FILE" && -f "$LEGACY_STAMP_FILE" ]]; then
  cp "$LEGACY_STAMP_FILE" "$STAMP_FILE" 2>/dev/null || true
fi
LOCK_HELD=0
cleanup_lock() {
  if (( LOCK_HELD )); then
    rm -rf "$LOCK_DIR" 2>/dev/null || true
    LOCK_HELD=0
  fi
}
trap cleanup_lock EXIT INT TERM

if (( TOUCH_UI )); then
  mkdir -p "$STATE_DIR"
  START_TS="$(python3 - <<'PY'
import time; print(time.time())
PY
)"
  while ! mkdir "$LOCK_DIR" 2>/dev/null; do
    OLD_PID="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
    if [[ -n "$OLD_PID" ]] && ! kill -0 "$OLD_PID" 2>/dev/null; then
      rm -rf "$LOCK_DIR" 2>/dev/null || true
      continue
    fi
    ELAPSED="$(python3 - "$START_TS" <<'PY'
import sys,time; print(time.time()-float(sys.argv[1]))
PY
)"
    if python3 - "$ELAPSED" "$LOCK_WAIT_SEC" <<'PY'
import sys
raise SystemExit(0 if float(sys.argv[1])>=float(sys.argv[2]) else 1)
PY
    then
      [[ "$CMD" == "watch" ]] && exit 0
      emit_tempfail PACING_DEFERRED DEFERRED UI_LOCK_BUSY "$LOCK_WAIT_SEC" "" >&2
      exit 75
    fi
    sleep 0.25
  done
  LOCK_HELD=1
  print -r -- "$$" > "$LOCK_DIR/pid"

  INTERVAL="$UI_MIN_INTERVAL_SEC"
  (( HEAVY_UI )) && INTERVAL="$UI_HEAVY_INTERVAL_SEC"
  WAIT_SEC="$(python3 - "$STAMP_FILE" "$INTERVAL" <<'PY'
import pathlib,sys,time
p=pathlib.Path(sys.argv[1]); interval=float(sys.argv[2])
try: last=float(p.read_text().strip())
except Exception: last=0.0
print(max(0.0,interval-(time.time()-last)))
PY
)"
  if python3 - "$WAIT_SEC" "$MAX_INLINE_WAIT_SEC" <<'PY'
import sys
raise SystemExit(0 if float(sys.argv[1])>float(sys.argv[2])+0.01 else 1)
PY
  then
    cleanup_lock
    [[ "$CMD" == "watch" ]] && exit 0
    emit_tempfail PACING_DEFERRED DEFERRED UI_PACING "$WAIT_SEC" "" >&2
    exit 75
  fi
  if python3 - "$WAIT_SEC" <<'PY'
import sys
raise SystemExit(0 if float(sys.argv[1])>0.01 else 1)
PY
  then
    sleep "$WAIT_SEC"
  fi
fi

ARGS_JSON="$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1:], ensure_ascii=False))' "$@")"
CONFIG_JSON="$(python3 -c 'import json,os; print(json.dumps(os.environ.get("CHAT_BRIDGE_CONFIG_DIR")))' )"
STATE_JSON="$(python3 -c 'import json,os; print(json.dumps(os.environ.get("CHAT_BRIDGE_STATE_DIR")))' )"
STORE_PATH="${MAIN:h}/state-store.py"
[[ -f "$STORE_PATH" ]] || { echo "chat-bridge: state store missing: $STORE_PATH" >&2; exit 127; }
STORE_JSON="$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$STORE_PATH")"
COORDINATOR_JSON="$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "${MAIN:h}/coordinator.py")"

if [[ "$CMD" == "space" && "$SUB" == "restore" && "$(uname -s)" == "Darwin" ]]; then
  EGO_LITE_APP="${EGO_LITE_APP:-/Applications/ego lite.app}"
  [[ -d "$EGO_LITE_APP" ]] && open -a "$EGO_LITE_APP" >/dev/null
fi

RUNNER="${MAIN:h}/ego-runner.py"
[[ -f "$RUNNER" ]] || { echo "chat-bridge: ego runner missing: $RUNNER" >&2; exit 127; }

set +e
{
  printf 'globalThis.__CHAT_BRIDGE_ARGS__ = %s;\n' "$ARGS_JSON"
  printf 'globalThis.__CHAT_BRIDGE_CONFIG_DIR__ = %s;\n' "$CONFIG_JSON"
  printf 'globalThis.__CHAT_BRIDGE_STATE_DIR__ = %s;\n' "$STATE_JSON"
  printf 'globalThis.__CHAT_BRIDGE_STORE_PATH__ = %s;\n' "$STORE_JSON"
  printf 'globalThis.__CHAT_BRIDGE_COORDINATOR_PATH__ = %s;\n' "$COORDINATOR_JSON"
  [[ -n "$SPACE_CATALOG_JSON" ]] && printf 'globalThis.__CHAT_BRIDGE_SPACE_CATALOG__ = await import(%s);\n' "$SPACE_CATALOG_JSON"
  cat "$CONTROL"
  cat "$PAGE_POOL"
  cat "$LIVENESS"
  cat "$TASK_POLICY"
  cat "$LIFECYCLE_POLICY"
  cat "$WEB_POLICY"
  cat "$MODEL_POLICY"
  cat "$SESSION_POLICY"
  cat "$EVENT_JOURNAL"
  cat "$TOPOLOGY"
  cat "$MAIN"
} | python3 "$RUNNER" "$EGO_BROWSER" "$EGO_CLIENT_TIMEOUT_SEC"
RC=$?
set -e

if (( TOUCH_UI )); then
  python3 - "$STAMP_FILE" <<'PY'
import pathlib,sys,time
p=pathlib.Path(sys.argv[1]); p.parent.mkdir(parents=True,exist_ok=True)
p.write_text(str(time.time())+"\n")
PY
fi
exit "$RC"
