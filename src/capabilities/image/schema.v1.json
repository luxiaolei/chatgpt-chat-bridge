{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chatbridge:image:v1",
  "title": "ChatBridge ImageJob v1 — names and digests are not authorization",
  "$ref": "#/$defs/Request",
  "$defs": {
    "Scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenantId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "workgroupId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "tenantId",
        "namespace",
        "purpose",
        "workgroupId"
      ]
    },
    "Caller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "chat",
            "codex",
            "hzos"
          ]
        },
        "ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "required": [
        "kind",
        "ref"
      ]
    },
    "Route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "projectId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "accountAlias": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "accountId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sessionRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "conversationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "required": [
        "project",
        "projectId",
        "accountAlias",
        "accountId",
        "sessionRef",
        "conversationId"
      ]
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifactRef": {
          "type": "string",
          "minLength": 3,
          "maxLength": 512,
          "pattern": "^(artifact|store|urn):[^\\s]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "revisionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "outputId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "jobId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "enum": [
            "source",
            "reference"
          ]
        }
      },
      "required": [
        "artifactRef",
        "sha256",
        "revisionId",
        "outputId",
        "jobId",
        "role"
      ]
    },
    "BaseRevision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifactRef": {
          "type": "string",
          "minLength": 3,
          "maxLength": 512,
          "pattern": "^(artifact|store|urn):[^\\s]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "revisionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "outputId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "jobId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "artifactRef",
        "sha256",
        "revisionId",
        "outputId",
        "jobId"
      ]
    },
    "Mask": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifactRef": {
          "type": "string",
          "minLength": 3,
          "maxLength": 512,
          "pattern": "^(artifact|store|urn):[^\\s]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceRevisionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "coordinateSpace": {
          "const": "source-pixels"
        },
        "mode": {
          "enum": [
            "native-region",
            "deterministic-composite"
          ]
        }
      },
      "required": [
        "artifactRef",
        "sha256",
        "sourceSha256",
        "sourceRevisionId",
        "width",
        "height",
        "coordinateSpace",
        "mode"
      ]
    },
    "Budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "maxOutputs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "maxDurationMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        },
        "deadlineAt": {
          "type": "string",
          "format": "date-time"
        },
        "allowPaidApi": {
          "const": false
        }
      },
      "required": [
        "maxAttempts",
        "maxOutputs",
        "maxDurationMs",
        "deadlineAt",
        "allowPaidApi"
      ]
    },
    "OutputTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targetRef": {
          "type": "string",
          "minLength": 3,
          "maxLength": 512,
          "pattern": "^(artifact|store|urn):[^\\s]+$"
        },
        "retentionHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8760
        }
      },
      "required": [
        "targetRef",
        "retentionHours"
      ]
    },
    "ModelSelection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "effort": {
          "anyOf": [
            {
              "enum": [
                "Instant",
                "Medium",
                "High",
                "Extra High",
                "Pro"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "raw": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        },
        "verified": {
          "type": "boolean"
        }
      },
      "required": [
        "model",
        "effort",
        "raw",
        "verified"
      ]
    },
    "Feature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "NATIVE",
            "ASSISTED",
            "UNSUPPORTED",
            "UNKNOWN"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 512,
            "pattern": "^(artifact|store|urn):[^\\s]+$"
          },
          "maxItems": 8
        }
      },
      "required": [
        "mode",
        "evidence"
      ]
    },
    "Capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "observedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "route": {
          "$ref": "#/$defs/Route"
        },
        "modelSelection": {
          "$ref": "#/$defs/ModelSelection"
        },
        "features": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "generate": {
              "$ref": "#/$defs/Feature"
            },
            "edit": {
              "$ref": "#/$defs/Feature"
            },
            "refine": {
              "$ref": "#/$defs/Feature"
            },
            "export": {
              "$ref": "#/$defs/Feature"
            },
            "multiReference": {
              "$ref": "#/$defs/Feature"
            },
            "mask": {
              "$ref": "#/$defs/Feature"
            },
            "deterministicComposite": {
              "$ref": "#/$defs/Feature"
            },
            "batch": {
              "$ref": "#/$defs/Feature"
            }
          },
          "required": [
            "generate",
            "edit",
            "refine",
            "export",
            "multiReference",
            "mask",
            "deterministicComposite",
            "batch"
          ]
        }
      },
      "required": [
        "version",
        "observedAt",
        "route",
        "modelSelection",
        "features"
      ]
    },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "chatbridge.image.v1"
        },
        "jobId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "requestDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "operation": {
          "enum": [
            "generate",
            "edit",
            "refine",
            "export"
          ]
        },
        "caller": {
          "$ref": "#/$defs/Caller"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "controllerTaskId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "route": {
          "$ref": "#/$defs/Route"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32000
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Source"
          },
          "maxItems": 8
        },
        "baseRevision": {
          "anyOf": [
            {
              "$ref": "#/$defs/BaseRevision"
            },
            {
              "type": "null"
            }
          ]
        },
        "mask": {
          "anyOf": [
            {
              "$ref": "#/$defs/Mask"
            },
            {
              "type": "null"
            }
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "aspectRatio": {
          "type": "string",
          "pattern": "^[1-9][0-9]?:[1-9][0-9]?$"
        },
        "conversationPolicy": {
          "enum": [
            "existing",
            "same-source"
          ]
        },
        "budget": {
          "$ref": "#/$defs/Budget"
        },
        "authorizedOutput": {
          "$ref": "#/$defs/OutputTarget"
        },
        "requestedModel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "requestedEffort": {
          "enum": [
            "Instant",
            "Medium",
            "High",
            "Extra High",
            "Pro"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "jobId",
        "requestDigest",
        "operation",
        "caller",
        "scope",
        "controllerTaskId",
        "route",
        "prompt",
        "inputs",
        "baseRevision",
        "mask",
        "count",
        "aspectRatio",
        "conversationPolicy",
        "budget",
        "authorizedOutput",
        "requestedModel",
        "requestedEffort"
      ]
    },
    "Grant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grantId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "controllerOperationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "controllerTaskId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "request": {
          "$ref": "#/$defs/Request"
        },
        "sourceExternalizationAuthorized": {
          "type": "boolean"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "capabilities": {
          "$ref": "#/$defs/Capabilities"
        }
      },
      "required": [
        "grantId",
        "controllerOperationId",
        "controllerTaskId",
        "request",
        "sourceExternalizationAuthorized",
        "expiresAt",
        "capabilities"
      ]
    },
    "Validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "UNVERIFIED",
            "VERIFIED"
          ]
        },
        "verifierVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "checkedAt": {
          "type": "string",
          "format": "date-time"
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "magic": {
              "type": "boolean"
            },
            "mime": {
              "type": "boolean"
            },
            "decode": {
              "type": "boolean"
            },
            "hash": {
              "type": "boolean"
            },
            "count": {
              "type": "boolean"
            }
          },
          "required": [
            "magic",
            "mime",
            "decode",
            "hash",
            "count"
          ]
        }
      },
      "required": [
        "status",
        "verifierVersion",
        "checkedAt",
        "checks"
      ]
    },
    "Output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outputId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "jobId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "attemptId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "turnId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "artifactRef": {
          "type": "string",
          "minLength": 3,
          "maxLength": 512,
          "pattern": "^(artifact|store|urn):[^\\s]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mimeType": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ]
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "sourceHashes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "maxItems": 8
        },
        "parentOutputId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "baseRevisionId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "capabilityVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "capabilityObservedAt": {
          "type": "string",
          "format": "date-time"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "maxItems": 32
        },
        "validation": {
          "$ref": "#/$defs/Validation"
        }
      },
      "required": [
        "outputId",
        "jobId",
        "attemptId",
        "turnId",
        "artifactRef",
        "sha256",
        "mimeType",
        "byteLength",
        "width",
        "height",
        "sourceHashes",
        "parentOutputId",
        "baseRevisionId",
        "capabilityVersion",
        "capabilityObservedAt",
        "warnings",
        "validation"
      ]
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "chatbridge.image.receipt.v1"
        },
        "receiptId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "consumerRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "jobId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "requestDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "outputId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "artifactRef": {
          "type": "string",
          "minLength": 3,
          "maxLength": 512,
          "pattern": "^(artifact|store|urn):[^\\s]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "receivedAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "RECEIVED",
            "REJECTED"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "receiptId",
        "consumerRef",
        "jobId",
        "requestDigest",
        "outputId",
        "artifactRef",
        "sha256",
        "receivedAt",
        "status",
        "reason"
      ]
    },
    "Status": {
      "enum": [
        "SUBMITTED",
        "SUBMISSION_UNKNOWN",
        "GENERATING",
        "GENERATED",
        "PARTIAL",
        "EXPORTED",
        "TECHNICALLY_VALIDATED",
        "BLOCKED",
        "FAILED_PRE_SEND",
        "FAILED",
        "EXPORT_UNAVAILABLE",
        "CANCEL_REQUESTED",
        "CANCELLED"
      ]
    },
    "Key": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grantId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "callerRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "jobId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        }
      },
      "required": [
        "grantId",
        "callerRef",
        "jobId",
        "scope"
      ]
    }
  }
}
